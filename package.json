{
  "name": "@tertium/js",
  "version": "2.8.0",
  "description": "Shared JS configs and types.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tertiumnon/tertium-js"
  },
  "exports": {
    "./core/*": "./core/*",
    "./entities/*": "./entities/*",
    "./scripts/*": "./scripts/*"
  },
  "files": [
    "scripts/",
    "core/",
    "entities/"
  ],
  "scripts": {
    "clean": "bun scripts/clean/clean.ts",
    "env:push": "bun scripts/aws-env/aws-env.ts push",
    "env:pull": "bun scripts/aws-env/aws-env.ts pull",
    "env:sync": "bun scripts/aws-env/aws-env.ts sync",
    "env:deploy": "bun scripts/aws-env/aws-env.ts deploy",
    "release:patch": "bun scripts/release/release.ts patch",
    "release:minor": "bun scripts/release/release.ts minor",
    "release:major": "bun scripts/release/release.ts major",
    "workflow:publish": "bun scripts/npm-publish-workflow/npm-publish-workflow.ts",
    "hooks:install": "bun scripts/git-hooks/git-hooks.ts",
    "test": "bun test --no-coverage || echo 'No tests found'",
    "lint": "biome check scripts core entities",
    "lint:fix": "biome check --write scripts core entities",
    "typecheck": "tsc --noEmit",
    "format": "biome format scripts core entities",
    "prepare": "git config core.hooksPath .githooks"
  },
  "author": "Vitalii Balabanov",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.0.9",
    "typescript": "^5.8.3"
  }
}
