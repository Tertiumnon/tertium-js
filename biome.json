{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "files": {
    "includes": ["scripts/**", "core/**", "entities/**"],
    "ignoreUnknown": true
  }
}
